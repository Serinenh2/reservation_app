# Copy this file to ".env" and change the values marked CHANGE.

# --- Security (CHANGE the secret key: any long random text) ---
DJANGO_SECRET_KEY=CHANGE-me-to-a-long-random-sentence-0123456789
DJANGO_DEBUG=0
TZ=Africa/Algiers

# --- First administrator account (created on first start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-me-Admin-2026
ADMIN_EMAIL=

# --- Email (default: printed in logs, works offline) ---
# For real emails (needs internet), use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=reservations@localhost
